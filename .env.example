OPENROUTER_API_KEY=<openrouter-api-key>
OPENROUTER_MODEL=anthropic/claude-opus-4.8
BSD_API_KEY=<bsd-api-key>
DISCORD_BOT_TOKEN=<discord-bot-token>
# Opcional: webhook de Discord para alertas del health monitor
DISCORD_HEALTH_WEBHOOK=<discord-webhook-url>

# === Configuración del modelo predictivo ===

# Fracción Kelly Criterion (0.25 = quarter-Kelly)
KELLY_FRACTION=0.25

# Bankroll base en unidades (para cálculo de stakes)
BANKROLL_UNITS=1000
