OPENROUTER_API_KEY=sk-or-v1-...
BSD_API_KEY=...
DISCORD_BOT_TOKEN=...
# Opcional: webhook de Discord para alertas del health monitor
DISCORD_HEALTH_WEBHOOK=https://discord.com/api/webhooks/...

# === Configuración del modelo predictivo ===

# Fracción Kelly Criterion (0.25 = quarter-Kelly)
